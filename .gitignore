# Ignore everything at the repository root
/*

# ...except the Cargo project files (moved to root from source_code/)
!/Cargo.toml
!/Cargo.lock
!/src/
!/src/**

# ...except the README and the logo banner
!/README.md
!/logo/
!/logo/**

# Ignore the HTML logo sources (SVG versions are preferred; HTML inflates lang stats)
/logo/*.html

# Rust build output
/target/

# Editor / OS junk
**/*.swp
**/.vscode/
**/.idea/
**/.DS_Store
**/Thumbs.db